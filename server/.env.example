PORT=5000
JWT_SECRET=replace-with-a-long-random-string

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=paste-your-iam-access-key-id
AWS_SECRET_ACCESS_KEY=paste-your-iam-secret-access-key
# Existing S3 bucket name in AWS (cannot be renamed). The service is Amazon Bedrock.
S3_BUCKET_NAME=amazon-beadrock

BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-root-password
# Existing local MySQL database name
MYSQL_DATABASE=amazonbedrock
